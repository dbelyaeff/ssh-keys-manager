---
import { FeatureCard } from './FeatureCard';

interface Feature {
	title: string;
	description: string;
	icon: string;
}

interface Props {
	title: string;
	features: Feature[];
}

const { title, features } = Astro.props;
---

<section class="py-20 md:py-32 relative">
	<div class="max-w-7xl mx-auto px-6">
		<h2 class="text-3xl md:text-5xl font-display font-bold text-center mb-16 md:mb-20 whitespace-pre-line reveal">{title}</h2>
		
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
			{features.map((feature, index) => (
				<div class={`reveal delay-${(index + 1) * 100}`}>
					<FeatureCard 
						client:visible
						title={feature.title}
						description={feature.description}
						iconName={feature.icon}
						index={index}
					/>
				</div>
			))}
		</div>
	</div>
</section>
