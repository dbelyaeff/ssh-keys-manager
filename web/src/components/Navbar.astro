---
interface Props {
	lang: 'en' | 'ru';
}

const { lang } = Astro.props;
---

<nav class="fixed top-0 left-0 w-full z-50 py-6">
	<div class="max-w-7xl mx-auto px-6 flex justify-between items-center">
		<div class="flex items-center gap-2">
			<div class="w-8 h-8 rounded-lg overflow-hidden shadow-[0_0_15px_rgba(0,242,255,0.4)]">
				<img src="/apple-touch-icon.png" alt="SSH Keys Manager Logo" class="w-full h-full object-cover" />
			</div>
			<span class="font-display text-lg font-bold tracking-tight">SSH Keys Manager</span>
		</div>
		
		<div class="flex items-center gap-6">
			<div class="flex items-center gap-3 glass px-3 py-1.5 rounded-full text-xs font-semibold">
				<a href="/en" class={lang === 'en' ? 'text-electric' : 'hover:text-electric transition-colors'}>EN</a>
				<div class="w-1 h-1 rounded-full bg-white/20"></div>
				<a href="/" class={lang === 'ru' ? 'text-electric' : 'hover:text-electric transition-colors'}>RU</a>
			</div>
			<a href="https://github.com/dbelyaeff/ssh-keys-manager" target="_blank" class="btn-secondary py-2 text-sm"> GitHub </a>
		</div>
	</div>
</nav>
