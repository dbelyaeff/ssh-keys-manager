---
interface Props {
	lang: 'en' | 'ru';
}

const { lang } = Astro.props;
---

<nav id="navbar" class="fixed top-0 left-0 w-full z-50 py-6 transition-all duration-500 ease-in-out border-b border-transparent">
	<div id="navbar-container" class="max-w-7xl mx-auto px-6 flex items-center justify-between transition-all duration-500 relative z-[110]">
		<div class="flex items-center gap-2">
			<img src="/apple-touch-icon.png" alt="Logo" class="w-8 h-8 rounded-lg shadow-lg shadow-electric/20" />
			<span class="font-display text-lg font-bold tracking-tight">SSH Keys Manager</span>
		</div>
		
		<!-- Desktop Menu -->
		<div class="hidden md:flex items-center gap-4">
			<a href="https://github.com/dbelyaeff/ssh-keys-manager/releases" class="download-btn btn-primary py-2 px-6 text-sm opacity-0 -translate-x-4 pointer-events-none transition-all duration-500 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
				{lang === 'ru' ? 'Скачать' : 'Download'}
			</a>
			<div class="flex items-center gap-3 glass px-3 py-1.5 rounded-full text-xs font-semibold">
				<a href="/en" class={lang === 'en' ? 'text-electric' : 'hover:text-electric transition-colors'}>EN</a>
				<div class="w-1 h-1 rounded-full bg-white/20"></div>
				<a href="/" class={lang === 'ru' ? 'text-electric' : 'hover:text-electric transition-colors'}>RU</a>
			</div>
			<a href="https://github.com/dbelyaeff/ssh-keys-manager" target="_blank" class="btn-secondary py-2 px-4 text-sm flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-github"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
				GitHub
			</a>
		</div>

		<!-- Mobile Menu Toggle -->
		<button id="mobile-menu-toggle" class="md:hidden flex items-center p-2 text-white hover:text-electric transition-colors focus:outline-none" aria-label="Toggle menu">
			<svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-menu"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
			<svg id="menu-icon-close" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
		</button>
	</div>

	<!-- Mobile Menu Overlay -->
	<div id="mobile-menu" class="fixed inset-0 bg-[#0A0A0B] z-[100] flex flex-col items-center justify-center gap-12 transition-all duration-500 opacity-0 pointer-events-none translate-y-10">
		<div class="flex flex-col items-center gap-8 text-2xl font-display font-bold">
			<a href="#features" class="mobile-link text-white/60 hover:text-white transition-colors">{lang === 'ru' ? 'Возможности' : 'Features'}</a>
			<a href="https://github.com/dbelyaeff/ssh-keys-manager" target="_blank" class="mobile-link text-white/60 hover:text-white transition-colors">GitHub</a>
			
			<div class="mt-4 flex items-center gap-4 bg-white/5 border border-white/10 px-8 py-4 rounded-full">
				<a href="/en" class={lang === 'en' ? 'text-electric' : 'text-white/40'}>EN</a>
				<div class="w-1.5 h-1.5 rounded-full bg-white/20"></div>
				<a href="/" class={lang === 'ru' ? 'text-electric' : 'text-white/40'}>RU</a>
			</div>
		</div>
		
		<a href="https://github.com/dbelyaeff/ssh-keys-manager/releases" class="btn-primary py-5 px-10 text-lg w-[85%] max-w-sm flex items-center justify-center gap-3 shadow-[0_0_40px_rgba(0,242,255,0.2)]">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
			{lang === 'ru' ? 'Скачать приложение' : 'Download App'}
		</a>
	</div>
</nav>

<style>
	@reference "../styles/global.css";

	nav.scrolled {
		@apply py-3 bg-black/40 backdrop-blur-xl border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.3)];
	}
	
	nav.scrolled #navbar-container {
		@apply max-w-5xl;
	}

	nav.scrolled .download-btn {
		@apply opacity-100 translate-x-0 pointer-events-auto;
	}

	#mobile-menu.active {
		@apply opacity-100 pointer-events-auto translate-y-0 shadow-2xl;
	}
</style>

<script>
	const navbar = document.getElementById('navbar');
	const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');
	const menuIconOpen = document.getElementById('menu-icon-open');
	const menuIconClose = document.getElementById('menu-icon-close');
	const mobileLinks = document.querySelectorAll('.mobile-link');
	
	// Scroll Logic
	window.addEventListener('scroll', () => {
		if (window.scrollY > 150) {
			navbar?.classList.add('scrolled');
		} else {
			navbar?.classList.remove('scrolled');
		}
	});

	// Mobile Menu Toggle
	const toggleMenu = () => {
		const isActive = mobileMenu?.classList.toggle('active');
		menuIconOpen?.classList.toggle('hidden');
		menuIconClose?.classList.toggle('hidden');
		
		if (isActive) {
			document.body.style.overflow = 'hidden';
			document.body.style.touchAction = 'none'; // Prevent scroll on some mobile browsers
		} else {
			document.body.style.overflow = '';
			document.body.style.touchAction = '';
		}
	};

	mobileMenuToggle?.addEventListener('click', toggleMenu);

	// Close menu on link click
	mobileLinks.forEach(link => {
		link.addEventListener('click', () => {
			mobileMenu?.classList.remove('active');
			menuIconOpen?.classList.remove('hidden');
			menuIconClose?.classList.add('hidden');
			document.body.style.overflow = '';
			document.body.style.touchAction = '';
		});
	});
</script>
