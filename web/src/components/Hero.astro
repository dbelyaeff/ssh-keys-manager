---
interface Props {
	title: string;
	subtitle: string;
	cta: string;
}

const { title, subtitle, cta } = Astro.props;
---

<section class="relative pt-40 pb-20 overflow-hidden">
	<!-- Animated Background Orbs -->
	<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
		<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-electric/20 rounded-full blur-[120px] animate-orb-1"></div>
		<div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[120px] animate-orb-2"></div>
		<div class="absolute top-[20%] right-[10%] w-[30%] h-[30%] bg-purple-600/10 rounded-full blur-[120px] animate-orb-3"></div>
	</div>

	<div class="max-w-7xl mx-auto px-6 text-center relative z-10 flex flex-col items-center">
		<!-- Interactive Icon Container with Glow -->
		<div class="relative group mb-10 reveal">
			<div id="hero-icon-glow" class="absolute inset-0 bg-electric/40 blur-[40px] rounded-full -z-10 transition-transform duration-300"></div>
			<div id="hero-icon-container" class="w-32 h-32 rounded-3xl overflow-hidden shadow-[0_0_50px_rgba(0,242,255,0.3)] glass p-1 animate-float transition-transform duration-200 ease-out">
				<img src="/apple-touch-icon.png" alt="SSH Keys Manager" class="w-full h-full object-cover rounded-[1.4rem]" />
			</div>
		</div>

		<div class="reveal delay-100">
			<h1 class="text-4xl md:text-6xl lg:text-7xl font-display font-bold mb-6 leading-tight flex flex-col items-center">
				<span class="text-white">{title.split('<br/>')[0]}</span>
				<span class="text-gradient drop-shadow-[0_0_30px_rgba(0,242,255,0.2)]">{title.split('<br/>')[1]}</span>
			</h1>
		</div>

		<div class="reveal delay-200">
			<p class="text-lg md:text-xl lg:text-2xl text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed font-medium px-4">
				{subtitle}
			</p>
		</div>

		<div class="flex flex-col sm:flex-row gap-4 justify-center items-center reveal delay-300">
			<a href="https://github.com/dbelyaeff/ssh-keys-manager/releases" class="btn-primary flex items-center gap-2 w-full sm:w-auto justify-center">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
				{cta}
			</a>
			<span class="text-xs text-slate-500 font-mono">v1.1.9 · macOS / Windows / Linux</span>
		</div>

		<!-- Homebrew Command Snippet -->
		<div class="mt-8 reveal delay-400 group cursor-pointer" id="copy-brew">
			<div class="inline-flex items-center gap-3 glass px-4 py-2 rounded-xl border-white/5 group-hover:border-electric/30 transition-all duration-300">
				<div class="w-2 h-2 rounded-full bg-electric animate-pulse"></div>
				<code class="text-xs md:text-sm font-mono text-slate-300">brew install --cask dbelyaeff/tap/sshkm</code>
				<div class="flex items-center gap-1.5 text-[10px] font-bold text-slate-500 uppercase tracking-widest border-l border-white/10 pl-3">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy transition-transform group-active:scale-90"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
					<span id="copy-text">Copy</span>
				</div>
			</div>
		</div>
	</div>
	
	<div class="mt-12 md:mt-20 max-w-5xl mx-auto px-6 relative reveal delay-500">
		<div class="absolute inset-0 bg-electric/20 blur-[120px] rounded-full top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -z-10"></div>
		<div class="glass p-1.5 md:p-2 rounded-2xl shadow-2xl overflow-hidden float max-h-[250px] md:max-h-[450px]">
			<img 
				src="/img/hero.png" 
				alt="SSH Keys Manager UI" 
				class="w-full h-full object-cover object-top rounded-xl"
				style="mask-image: linear-gradient(to bottom, black 80%, transparent 100%);"
			/>
		</div>
	</div>
</section>

<script>
	const container = document.getElementById('hero-icon-container');
	const glow = document.getElementById('hero-icon-glow');
	const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
	
	if (!isTouchDevice) {
		document.addEventListener('mousemove', (e) => {
			if (!container || !glow) return;
			
			const { clientX, clientY } = e;
			const { innerWidth, innerHeight } = window;
			
			const rotationX = ((clientY / innerHeight) - 0.5) * -20;
			const rotationY = ((clientX / innerWidth) - 0.5) * 20;
			
			container.style.transform = `perspective(1000px) rotateX(${rotationX}deg) rotateY(${rotationY}deg)`;
			glow.style.transform = `translate(${rotationY * -0.5}px, ${rotationX * 0.5}px)`;
		});
		
		document.addEventListener('mouseleave', () => {
			if (!container || !glow) return;
			container.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
			glow.style.transform = `translate(0, 0)`;
		});
	}

	// Reveal Observer
	const observerOptions = {
		threshold: 0.05
	};

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('active');
			}
		});
	}, observerOptions);

	document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

	// Copy to Clipboard Logic
	const copyBtn = document.getElementById('copy-brew');
	const copyText = document.getElementById('copy-text');
	
	copyBtn?.addEventListener('click', async () => {
		const command = 'brew install --cask dbelyaeff/tap/sshkm';
		try {
			await navigator.clipboard.writeText(command);
			if (copyText) {
				copyText.innerText = 'Copied!';
				copyText.classList.add('text-electric');
				setTimeout(() => {
					copyText.innerText = 'Copy';
					copyText.classList.remove('text-electric');
				}, 2000);
			}
		} catch (err) {
			console.error('Failed to copy: ', err);
		}
	});
</script>
