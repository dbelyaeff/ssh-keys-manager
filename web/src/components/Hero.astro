---
interface Props {
	title: string;
	subtitle: string;
	cta: string;
}

const { title, subtitle, cta } = Astro.props;
---

<section class="relative pt-40 pb-20 overflow-hidden">
	<!-- Animated Background Orbs -->
	<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none">
		<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-electric/20 rounded-full blur-[120px] animate-orb-1"></div>
		<div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-blue-600/10 rounded-full blur-[120px] animate-orb-2"></div>
		<div class="absolute top-[20%] right-[10%] w-[30%] h-[30%] bg-purple-600/10 rounded-full blur-[120px] animate-orb-3"></div>
	</div>

	<div class="max-w-7xl mx-auto px-6 text-center relative z-10">
		<h1 class="text-6xl md:text-8xl font-display font-bold mb-6 leading-tight flex flex-col items-center">
			<span class="text-white">{title.split('<br/>')[0]}</span>
			<span class="text-gradient drop-shadow-[0_0_30px_rgba(0,242,255,0.2)]">{title.split('<br/>')[1]}</span>
		</h1>
		<p class="text-xl md:text-2xl text-slate-400 max-w-3xl mx-auto mb-10 leading-relaxed font-medium">
			{subtitle}
		</p>
		<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
			<a href="https://github.com/dbelyaeff/ssh-keys-manager/releases" class="btn-primary flex items-center gap-2">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a2 2 0 002 2h12a2 2 0 002-2v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
				{cta}
			</a>
			<span class="text-xs text-slate-500 font-mono">v1.1.3 · macOS / Windows / Linux</span>
		</div>
	</div>
	
	<div class="mt-20 max-w-5xl mx-auto px-6 relative">
		<div class="absolute inset-0 bg-electric/20 blur-[120px] rounded-full top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -z-10"></div>
		<div class="glass p-2 rounded-2xl shadow-2xl overflow-hidden float">
			<img src={`${import.meta.env.BASE_URL}/img/hero.png`} alt="SSH Keys Manager UI" class="w-full rounded-xl" />
		</div>
	</div>
</section>
