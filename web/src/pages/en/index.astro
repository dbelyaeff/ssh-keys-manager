---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import P2P from '../../components/P2P.astro';
import Footer from '../../components/Footer.astro';

const icons = {
	key: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4.3a1 1 0 0 0-1.4 0l-2.1 2.1a1 1 0 0 0 0 1.4Z"/><path d="m15.5 7.5-3 3"/><path d="m13.5 15 2.5 2.5a5 5 0 1 1-7-7l11-11"/><path d="m11.5 13-3 3"/></svg>`,
	shield: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
	monitor: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>`,
	radio: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M7.76 7.76a6 6 0 0 0 0 8.49"/><path d="M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>`,
	terminal: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>`,
	lock: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
};

const features = [
	{
		title: "Identity Vault",
		description: "AES-256-GCM encryption with Argon2 key derivation. Your keys never leave your device unencrypted.",
		icon: icons.shield
	},
	{
		title: "Cross-Platform + WSL",
		description: "Native speed on macOS, Linux, and Windows. Unique seamless synchronization with WSL distros.",
		icon: icons.monitor
	},
	{
		title: "Smart SSH",
		description: "Auto-detects hostname availability and suggests key installation via ssh-copy-id if needed.",
		icon: icons.key
	},
	{
		title: "Intelligent Terminal",
		description: "Deep integration with Terminal.app, iTerm2, and Warp. Launches connections exactly where you want.",
		icon: icons.terminal
	},
	{
		title: "Privacy Focused",
		description: "Local-first architecture. No trackers, no external servers, no cloud telemetry. Just you and your keys.",
		icon: icons.lock
	},
	{
		title: "Zero Config P2P",
		description: "mDNS discovery finds devices on your local network for instant, secure direct transfer.",
		icon: icons.radio
	}
];
---

<Layout 
	title="SSH Keys Manager | The Ultimate Identity Vault"
	description="A modern, secure, and native desktop app for managing SSH keys and server connections. Export, sync, and protect your environment."
	lang="en"
>
	<Navbar lang="en" />
	
	<main>
		<Hero 
			title="The Ultimate Identity<br/>Vault for SSH"
			subtitle="Manage, synchronize, and protect your SSH environment across macOS, Windows, and Linux with native speed and uncompromising security."
			cta="Download Universal v1.1.3"
		/>
		
		<Features 
			title={"Architected for\nSecurity & Speed"}
			features={features}
		/>
		
		<P2P 
			imgSrc="/img/p2p_abstract.png"
			title="Lightning Fast P2P Synchronization"
			description="Moving to a new machine? Our local network P2P transfer uses encrypted TCP streams and PIN-based authentication to move your entire SSH environment in seconds. No cloud intermediaries required."
		/>
	</main>
	
	<Footer />
</Layout>
